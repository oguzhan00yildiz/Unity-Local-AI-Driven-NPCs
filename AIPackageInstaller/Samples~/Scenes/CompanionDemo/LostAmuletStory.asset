MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cddf024261284b7419e7bc73397e63da, type: 3}
  m_Name: LostAmuletStory
  m_EditorClassIdentifier: AIDrivenNPCs.Runtime::AISystem.StoryLore
  worldText: You live in Oakvale, a small village at the edge of a forest. North
    of the village a stone path leads through the forest to the old ruins. Two nights
    ago skeletons came out of the forest and stole the Silver Amulet from the Elder's
    house. The amulet is silver with a blue stone and has protected Oakvale for generations.
    Since the attack the gate to the forest path is closed and guarded. The people
    of Oakvale are the Elder, the Innkeeper, a Hunter who camps on the forest path,
    and the gate Guard. Today a traveller (the player) arrived with a companion.
  stages:
  - id: intro
    objective: Talk to the Village Elder in the square
    promptText: The traveller just arrived. Nobody has asked them for help yet.
  - id: started
    objective: Find out where the skeletons took the amulet
    promptText: The Elder asked the traveller to bring the Silver Amulet back. They
      are looking for it.
  - id: found
    objective: Bring the amulet back to the Elder
    promptText: The traveller found the Silver Amulet in the ruins and is carrying
      it now.
  - id: complete
    objective: 
    promptText: The amulet is back with the Elder. Oakvale is safe and celebrates
      the traveller.
