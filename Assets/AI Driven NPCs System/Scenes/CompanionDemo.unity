  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 150d5bd920204e94592fefc8db3c24d3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: AIDrivenNPCs.Runtime::AISystem.NPCKnowledge
  privateFacts: Three skeletons guard the old ruins at the end of this path. They
    put the Blue Stone in a wooden crate inside the ruins.
  stageDialogue:
  - stageId: started
    goal: When the traveller asks about the ruins, the skeletons or the Blue Stone,
      tell them what you know. Warn them that their companion should fight with them.
    openingLine: Quiet. You're loud for someone walking into skeleton country.
  - stageId: found
    goal: Tell the traveller to take the Blue Stone back to Elder Hugo.
    openingLine: You got it back. Go, Hugo is waiting.
  - stageId: complete
    goal: Tell the traveller the forest is quiet again.
    openingLine: The forest is quiet again. Good work.
