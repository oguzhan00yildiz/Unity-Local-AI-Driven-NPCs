--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cddf024261284b7419e7bc73397e63da, type: 3}
  m_Name: BlueStoneStory
  m_EditorClassIdentifier: AIDrivenNPCs.Runtime::AISystem.StoryLore
  worldText: 'Elmford is a small village at the edge of a forest. A stone path leads
    north through the forest gate to the old ruins. Two nights ago skeletons came
    out of the forest and took the Blue Stone from Elder Emil''s house. The Blue
    Stone is a fist-sized blue gem that has kept Elmford safe for a hundred years.
    Since that night the forest gate is closed. The people of Elmford: Elder Emil
    in the village square, Iida who runs the inn, Ville who guards the forest gate,
    and Giacomo the hunter who camps on the forest path behind the gate. Today a
    traveller (the player) arrived with a companion.'
  stages:
  - id: intro
    objective: Talk to Elder Emil in the square
    promptText: The traveller just arrived. Nobody has asked them for help yet.
  - id: started
    objective: Find out where the skeletons took the Blue Stone
    promptText: Elder Emil asked the traveller to bring the Blue Stone back. They
      are looking for it.
  - id: found
    objective: Bring the Blue Stone back to Elder Emil
    promptText: The traveller found the Blue Stone in the ruins and is carrying it
      now.
  - id: complete
    objective: 
    promptText: The Blue Stone is back with Elder Emil. Elmford is safe and celebrates
      the traveller.
